# Copy this file to .env and fill in your values.

# Your public domain for the dashboard (used by Caddy for Let's Encrypt).
# For LAN use, edit Caddyfile directly and remove this variable.
SDDB_DOMAIN=sddb.example.com

# AI provider API keys (optional — configure whichever you use).
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OLLAMA_BASE_URL=http://192.168.1.50:11434
# OLLAMA_MODEL=llama3.2

# Reverse proxy settings (see "Security notes" in the README).
# When Caddy runs in its own container, trust its Docker network so login
# rate limiting sees real client addresses:
# SDDB_TRUSTED_PROXIES=172.16.0.0/12
# SDDB_TRUSTED_ORIGINS=https://sddb.example.com
