[Unit]
Description=SDDB Container Agent
Documentation=https://github.com/smokinstack/sddb
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/sddb-agent \
  -addr :8484 \
  -interval 5s \
  -tls-cert /etc/sddb/agent.crt \
  -tls-key  /etc/sddb/agent.key \
  -tls-ca   /etc/sddb/ca.crt

# Drop privileges — run as the sddb user (must be in the docker group)
User=sddb
Group=sddb

# Restart on failure with a short back-off
Restart=on-failure
RestartSec=5s

# Basic hardening
NoNewPrivileges=true
ProtectSystem=strict
# Compose upgrades run `docker compose` in each project's directory, and those
# often live under /home (e.g. /home/you/plex). ProtectHome=true would hide them
# and make every compose upgrade fail, so home directories are read-only here.
# The sddb user also needs read access to those project directories: Ubuntu
# creates home directories as 0750, so either add sddb to the owner's group
# (sudo usermod -aG <owner> sddb) or keep compose projects outside /home.
ProtectHome=read-only
ReadWritePaths=/etc/sddb

[Install]
WantedBy=multi-user.target
